{% extends "layouts/base.twig" %}

{% block content %}
<div class="container">
    <div class="actions">
        <h1>Admin Users</h1>
        {% if user.canManageUsers() %}
        <a href="/users/create" class="btn btn-primary">Create New User</a>
        {% endif %}
    </div>

    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for admin_user in users %}
                <tr>
                    <td>{{ admin_user.username }}</td>
                    <td>{{ admin_user.full_name }}</td>
                    <td>{{ admin_user.email }}</td>
                    <td>
                        <span class="badge badge-info">{{ admin_user.role_name }}</span>
                    </td>
                    <td>
                        {% if admin_user.is_locked %}
                            <span class="badge badge-danger">Locked</span>
                        {% elseif admin_user.is_active %}
                            <span class="badge badge-success">Active</span>
                        {% else %}
                            <span class="badge badge-warning">Inactive</span>
                        {% endif %}
                    </td>
                    <td>{{ admin_user.last_login ?? 'Never' }}</td>
                    <td>
                        {% if user.canManageUsers() %}
                        <div class="btn-group">
                            <a href="/users/{{ admin_user.id }}/edit" class="btn btn-sm btn-secondary">Edit</a>
                            {% if admin_user.id != user.id %}
                            <form method="POST" action="/users/{{ admin_user.id }}/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                            {% endif %}
                        </div>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" style="text-align: center; color: #999;">No admin users found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
